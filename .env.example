# ------------------------------------------------------------
# Supabase (optional)
#
# Leave these EMPTY to run Momentum in local mode — data is stored
# in the browser (localStorage) and the app works fully offline.
#
# Fill them in to switch to cloud mode: real auth + multi-device sync.
# Get them from your Supabase project → Settings → API.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
